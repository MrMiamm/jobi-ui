{
  "name": "jobi-ui-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "playgrounds/*"
  ],
  "scripts": {
    "dev": "npm run dev:nuxt",
    "dev:nuxt": "npm run dev -w playgrounds/nuxt",
    "dev:vue": "npm run dev -w playgrounds/vue",
    "typegen:nuxt": "npm run typegen -w playgrounds/nuxt",
    "build": "npm run build --workspaces --if-present",
    "type-check": "npm run type-check -w jobi-ui && npm run type-check -w nuxt-jobi-ui && npm run type-check -w playgrounds/vue",
    "test:unit": "npm run test:unit -w jobi-ui",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli packages/ playgrounds/"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4.1.13",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "playwright": "latest"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
